# .gitignore
node_modules/
package-lock.json
.env
.gitignore
*.log
*.config
*.tmp
__pycache__/
*.swp
.DS_Store
coverage/

# .env ignores .env.local by prefix only, so name it and its variants explicitly
.env.local
.env.*.local

# Generated by `pnpm run build`; desktop:installer rebuilds it before packaging
dist/

release/
release-*/
tmp/electron-*/
tmp/release-check/
.pnpm-store/
.venv-whisper/
