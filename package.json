{
  "name": "lampstand-studio",
  "private": true,
  "version": "0.1.28",
  "description": "A private, local-first AI workspace for family, ministry, church, school, and creative work.",
  "main": "desktop/main.cjs",
  "author": "Lampstand Project",
  "type": "module",
  "scripts": {
    "api": "node --env-file-if-exists=.env.local server/index.mjs",
    "whisper": ".venv-whisper\\Scripts\\python.exe -m uvicorn whisper_server.app:app --host 127.0.0.1 --port 8000",
    "setup:whisper": "powershell -ExecutionPolicy Bypass -File scripts/setup-whisper.ps1",
    "start:local": "powershell -ExecutionPolicy Bypass -File scripts/start-local.ps1",
    "dev": "vite",
    "build": "tsc -b && vite build",
    "lint": "oxlint",
    "preview": "vite preview",
    "test": "vitest run",
    "verify:release": "pnpm run lint && pnpm test && pnpm run build",
    "desktop": "electron desktop/main.cjs",
    "prepare:library-bundle": "powershell -NoProfile -ExecutionPolicy Bypass -File scripts/prepare-library-bundle.ps1",
    "desktop:pack": "pnpm run build && electron-builder --dir",
    "desktop:installer": "pnpm run prepare:library-bundle && pnpm run build && electron-builder --win nsis",
    "desktop:status": "powershell -NoProfile -ExecutionPolicy Bypass -File scripts/aios-control.ps1 -Action Status",
    "desktop:backup": "powershell -NoProfile -ExecutionPolicy Bypass -File scripts/aios-control.ps1 -Action Backup",
    "hymnal:import": "node server/hymnal-import.mjs"
  },
  "dependencies": {
    "@tailwindcss/vite": "^4.3.3",
    "axios": "^1.19.0",
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "electron-updater": "^6.8.9",
    "highlight.js": "^11.11.1",
    "lucide-react": "^1.28.0",
    "react": "^19.2.7",
    "react-dom": "^19.2.7",
    "react-markdown": "^10.1.0",
    "react-router-dom": "^7.18.2",
    "reactflow": "^11.11.4",
    "rehype-highlight": "^7.0.2",
    "remark-gfm": "^4.0.1",
    "tailwind-merge": "^3.6.0",
    "tailwindcss": "^4.3.3",
    "zustand": "^5.0.14"
  },
  "build": {
    "appId": "studio.lampstand.desktop",
    "productName": "Lampstand Project",
    "artifactName": "Lampstand-Project-Setup-${version}.${ext}",
    "executableName": "Lampstand Project",
    "directories": {
      "output": "release"
    },
    "files": [
      "desktop/**/*",
      "dist/**/*",
      "public/favicon.svg",
      "package.json"
    ],
    "extraResources": [
      {
        "from": "server",
        "to": "server",
        "filter": [
          "**/*.mjs",
          "**/*.py",
          "!**/*.test.mjs"
        ]
      },
      {
        "from": "scripts",
        "to": "scripts",
        "filter": [
          "**/*.ps1",
          "**/*.py"
        ]
      },
      {
        "from": "whisper_server",
        "to": "whisper_server"
      },
      {
        "from": "python_overrides",
        "to": "python_overrides"
      },
      {
        "from": "data",
        "to": "data",
        "filter": [
          "**/*",
          "!**/*.previous.sqlite",
          "!**/*.bak"
        ]
      }
    ],
    "asar": true,
    "win": {
      "icon": "build-assets/lampstand-studio.ico",
      "target": [
        {
          "target": "nsis",
          "arch": [
            "x64"
          ]
        }
      ]
    },
    "publish": [
      {
        "provider": "github",
        "owner": "github4ai",
        "repo": "Lampstand-Project",
        "releaseType": "release"
      }
    ],
    "nsis": {
      "oneClick": false,
      "include": "build-assets/installer.nsh",
      "allowToChangeInstallationDirectory": true,
      "createDesktopShortcut": true,
      "createStartMenuShortcut": true,
      "shortcutName": "Lampstand Project",
      "deleteAppDataOnUninstall": false
    }
  },
  "devDependencies": {
    "@types/node": "^24.13.2",
    "@types/react": "^19.2.17",
    "@types/react-dom": "^19.2.3",
    "@vitejs/plugin-react": "^6.0.3",
    "electron": "^43.4.0",
    "electron-builder": "^26.15.3",
    "oxlint": "^1.71.0",
    "typescript": "~6.0.2",
    "vite": "^8.1.1",
    "vitest": "^4.1.10"
  }
}
