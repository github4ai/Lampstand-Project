VITE_AIOS_API_URL=http://127.0.0.1:8766

# Optional Lampstand remote family-access control. These are public client values;
# never place a Supabase service-role key in the desktop app.
VITE_LAMPSTAND_CLOUD_URL=
VITE_LAMPSTAND_CLOUD_PUBLIC_KEY=

# Hybrid uses local providers first, then OpenAI when OPENAI_API_KEY is set.
AIOS_PROVIDER_MODE=hybrid
AIOS_API_HOST=127.0.0.1
AIOS_API_PORT=8766
AIOS_ALLOWED_ORIGINS=http://localhost:5173,http://127.0.0.1:5173,http://localhost:5174,http://127.0.0.1:5174

OLLAMA_URL=http://127.0.0.1:11434
OLLAMA_TRANSLATION_MODEL=qwen3:8b
WHISPER_URL=http://127.0.0.1:8000
WHISPER_MODEL=whisper-1
AIOS_LEGACY_API_URL=http://127.0.0.1:8765

# Optional cloud fallback. Keep secrets in .env.local, which Git ignores.
OPENAI_API_KEY=
OPENAI_BASE_URL=https://api.openai.com/v1
OPENAI_TEXT_MODEL=gpt-4.1-mini
OPENAI_TRANSCRIPTION_MODEL=gpt-4o-mini-transcribe
AIOS_MAX_AUDIO_MB=25
AIOS_KNOWLEDGE_DIR=I:\AI\Knowledge
AIOS_KNOWLEDGE_TRASH_DIR=I:\AI\Knowledge Trash
AIOS_KNOWLEDGE_INDEX_DIR=I:\AI\Index
AIOS_MAX_KNOWLEDGE_MB=100
AIOS_INDEX_PYTHON=C:\Users\YOUR_NAME\AppData\Local\Programs\Python\Python311\python.exe
AIOS_INDEX_SCRIPT=I:\AI\AIOS_Studio\scripts\prepare-and-index.py
AIOS_INDEX_BUILDER=I:\AI\Scripts\Indexing\build_index.py
AIOS_OCR_ARCHIVE=I:\AI\OCR\Archive
# Local image generation (ComfyUI)
COMFYUI_URL=http://127.0.0.1:8188
COMFYUI_CHECKPOINT=juggernautXL_v8Rundiffusion.safetensors
ULTIMATE_TTS_URL=http://127.0.0.1:7860
