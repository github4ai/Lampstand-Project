VITE_AIOS_API_URL=http://127.0.0.1:8765

# Hybrid uses local providers first, then OpenAI when OPENAI_API_KEY is set.
AIOS_PROVIDER_MODE=hybrid
AIOS_API_HOST=127.0.0.1
AIOS_API_PORT=8765
AIOS_ALLOWED_ORIGINS=http://localhost:5173,http://127.0.0.1:5173,http://localhost:5174,http://127.0.0.1:5174

OLLAMA_URL=http://127.0.0.1:11434
OLLAMA_TRANSLATION_MODEL=qwen3:8b
WHISPER_URL=http://127.0.0.1:8000
WHISPER_MODEL=whisper-1

# Optional cloud fallback. Keep secrets in .env.local, which Git ignores.
OPENAI_API_KEY=
OPENAI_BASE_URL=https://api.openai.com/v1
OPENAI_TEXT_MODEL=gpt-4.1-mini
OPENAI_TRANSCRIPTION_MODEL=gpt-4o-mini-transcribe
AIOS_MAX_AUDIO_MB=25
